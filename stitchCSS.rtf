        chips.forEach(c => \{\
          c.setAttribute('aria-checked', 'false');\
          c.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-sm');\
          c.classList.add('bg-surface-container-low', 'text-on-surface');\
          const icon = c.querySelector('.material-symbols-outlined');\
          if (icon) \{\
            icon.classList.remove('text-on-secondary');\
            icon.classList.add('text-on-surface-variant');\
          \}\
        \});\
\
        if (!isAlreadyChecked) \{\
          chip.setAttribute('aria-checked', 'true');\
          chip.classList.remove('bg-surface-container-low', 'text-on-surface');\
          chip.classList.add('bg-secondary', 'text-on-secondary', 'shadow-sm');\
          const icon = chip.querySelector('.material-symbols-outlined');\
          if (icon) \{\
            icon.classList.remove('text-on-surface-variant');\
            icon.classList.add('text-on-secondary');\
          \}\
          if (feedback) feedback.classList.remove('opacity-0');\
        \} else \{\
          if (feedback) feedback.classList.add('opacity-0');\
        \}\
      \});\
    \});\
\
    const confirmBtn = document.getElementById('confirm-btn');\
    if (confirmBtn) \{\
      confirmBtn.addEventListener('click', () => \{\
        confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span> Storing gently...';\
