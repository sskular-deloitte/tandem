<script>\
  function selectOption(buttonElement, feedbackText) \{\
    // Reset all cards\
    const cards = document.querySelectorAll('.choice-card');\
    cards.forEach(card => \{\
      card.classList.remove('bg-secondary-fixed', 'shadow-md');\
      card.classList.add('bg-surface-container-lowest');\
    \});\
\
    // Highlight selected card smoothly with safe sage warmth\
    buttonElement.classList.remove('bg-surface-container-lowest');\
    buttonElement.classList.add('bg-secondary-fixed', 'shadow-md');\
\
    // Show banner feedback\
    const banner = document.getElementById('selection-banner');\
    const label = document.getElementById('selection-text');\
    label.textContent = feedbackText;\
    banner.classList.remove('hidden');\
    banner.scrollIntoView(\{ behavior: 'smooth', block: 'nearest' \});\
  \}\
\
  function undoSelection() \{\
    const cards = document.querySelectorAll('.choice-card');\
    cards.forEach(card => \{\
      card.classList.remove('bg-secondary-fixed', 'shadow-md');\
      card.classList.add('bg-surface-container-lowest');\
    \});\
    document.getElementById('selection-banner').classList.add('hidden');\
  \}\
\
  function toggleVoiceRecording() \{\
    const status = document.getElementById('recording-status');\
    const label = document.getElementById('mic-label');\
    const icon = document.getElementById('mic-icon');\
    \
    if (status.classList.contains('hidden')) \{\
      status.classList.remove('hidden');\
      label.textContent = 'Finish';\
      icon.classList.add('text-error');\
      icon.textContent = 'stop_circle';\
    \} else \{\
      status.classList.add('hidden');\
      label.textContent = 'Record';\
      icon.classList.remove('text-error');\
      icon.textContent = 'mic';\
      // Gentle toast simulation\
      const banner = document.getElementById('selection-banner');\
      const text = document.getElementById('selection-text');\
      text.textContent = 'Voice memo tucked warmly onto this card for William.';\
      banner.classList.remove('hidden');\
    \}\
  \}\
\
  function cancelVoiceRecording() \{\
    const status = document.getElementById('recording-status');\
    const label = document.getElementById('mic-label');\
    const icon = document.getElementById('mic-icon');\
    status.classList.add('hidden');\
    label.textContent = 'Record';\
    icon.classList.remove('text-error');\
    icon.textContent = 'mic';\
  \}\
</script></main></body></html>\
