<script>\
  function selectAlignmentOption(buttonEl, person) \{\
    // Reset all buttons in the choice container\
    const allButtons = document.querySelectorAll('.alignment-btn');\
    allButtons.forEach(btn => \{\
      btn.classList.remove('bg-secondary-container', 'shadow-md');\
      btn.classList.add('bg-surface-container');\
      const indicator = btn.querySelector('.status-indicator');\
      if (indicator) \{\
        indicator.classList.remove('bg-secondary', 'text-on-secondary');\
        indicator.classList.add('bg-surface-bright');\
        const icon = indicator.querySelector('.material-symbols-outlined');\
        if (icon) \{\
          icon.classList.remove('text-on-secondary');\
          icon.classList.add('text-transparent');\
        \}\
      \}\
    \});\
\
    // Mark active selection\
    buttonEl.classList.remove('bg-surface-container');\
    buttonEl.classList.add('bg-secondary-container', 'shadow-md');\
    \
    const activeIndicator = buttonEl.querySelector('.status-indicator');\
    if (activeIndicator) \{\
      activeIndicator.classList.remove('bg-surface-bright');\
      activeIndicator.classList.add('bg-secondary');\
      const activeIcon = activeIndicator.querySelector('.material-symbols-outlined');\
      if (activeIcon) \{\
        activeIcon.classList.remove('text-transparent', 'group-hover:text-outline-variant');\
        activeIcon.classList.add('text-on-secondary');\
      \}\
    \}\
\
    // Gentle Feedback toast\
    const feedbackBanner = document.getElementById('selectionFeedback');\
    const feedbackText = document.getElementById('feedbackText');\
    if (feedbackBanner && feedbackText) \{\
      feedbackBanner.classList.remove('hidden');\
      feedbackBanner.classList.add('flex');\
      if (person === 'Together') \{\
        feedbackText.textContent = "Softly set aside for next weekend. Space preserved for right now.";\
      \} else \{\
        feedbackText.textContent = person + " warmly acknowledged to hold this thread this week.";\
      \}\
